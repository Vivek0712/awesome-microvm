{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "Logs", "Effect": "Allow", "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
     "Resource": ["arn:aws:logs:{region}:{account}:log-group:/aws/lambda/web/{name}:*",
                  "arn:aws:logs:*:{account}:log-group:/aws/lambda/web/{name}.local:*"]},
    {"Sid": "Jobs", "Effect": "Allow", "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem"],
     "Resource": "arn:aws:dynamodb:{region}:{account}:table/{table}"},
    {"Sid": "MicroVMs", "Effect": "Allow",
     "Action": ["lambda:RunMicrovm", "lambda:TerminateMicrovm", "lambda:CreateMicrovmAuthToken", "lambda:GetMicrovm"],
     "Resource": "*"},
    {"Sid": "Connectors", "Effect": "Allow", "Action": "lambda:PassNetworkConnector",
     "Resource": "arn:aws:lambda:*:aws:network-connector:aws-network-connector:*"}
  ]
}
